		description = "Six touches. De quoi couper son micro sans chercher la fenêtre, ce qui vaut déjà son prix.",
	},
	{
		id = "deck_standard",
		name = "Deck 15",
		brand = "Cadran",
		family = "tech",
		category = "streamdeck",
		style = "gamer",
		tier = 2,
		price = 190,
		keys = 15,
