		address = "cathy.dubreuil@wanadoo.fr",
		subject = "le bruit",
		preview = "mon chéri j'ai entendu crier hier vers 2h du matin, tout va bien ?",
		day = 2,
		unread = true,
		body = {
			"mon chéri",
