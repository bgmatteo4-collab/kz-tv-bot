{
  "name": "touchline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Habillage graphique pour la diffusion live de matchs de football",
  "scripts": {
    "dev": "node outils/dev.mjs",
    "serveur": "tsx watch serveur/index.ts",
    "clients": "vite",
    "tokens": "tsx outils/generer-tokens.ts",
    "construire": "npm run tokens && vite build",
    "demarrer": "npm run construire && tsx serveur/index.ts",
    "verifier": "tsc --noEmit -p tsconfig.json && svelte-check --threshold error",
    "test": "vitest run",
    "verifier-direct": "npm run construire && node outils/verifier-direct.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "playwright": "^1.62.1",
    "svelte": "^5.15.0",
    "svelte-check": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
